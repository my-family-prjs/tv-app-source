    "timeout_seconds": 10,
    "connect_timeout_seconds": 8,
    "retries": 2,
    "retry_delay_seconds": 1,
    "concurrency": 24,
    "max_keep": 40,
    "min_vod_count": 1,
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36",
    "output": "dist/cms_sources.json",
    "exclude_api_keywords": [
      "pz.v88.qzz.io"
    ]
  },
  "iptv": {
    "sources": [
      {
        "name": "Guovin/iptv-database",
        "url": "https://raw.githubusercontent.com/Guovin/iptv-database/master/result.txt",
        "format": "txt",
        "enabled": false
      },
      {
        "name": "iptv-org 中国频道",
        "url": "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/cn.m3u",
        "format": "m3u",
        "enabled": true,
        "whitelist": [
          "CCTV",
          "CGTN",
          "卫视",
          "Satellite TV"
        ],
        "说明": "英文命名的国际源，按白名单只留央视/卫视，地方英文台剔除"
      },
      {
        "name": "suxuang/myIPTV",
        "url": "https://raw.githubusercontent.com/suxuang/myIPTV/main/ipv6.m3u",
        "format": "m3u",
        "enabled": false
      },
      {
        "name": "kimwang1978/collect-tv-txt",
        "url": "https://raw.githubusercontent.com/kimwang1978/collect-tv-txt/main/merged_output.txt",
        "format": "txt",
        "enabled": true
      },
      {
        "name": "xzw832/cmys 央视频道",
        "url": "https://raw.githubusercontent.com/xzw832/cmys/main/S_CCTV.txt",
        "format": "txt",
        "enabled": true
      },
      {
        "name": "xzw832/cmys 卫视频道",
        "url": "https://raw.githubusercontent.com/xzw832/cmys/main/S_weishi.txt",
        "format": "txt",
        "enabled": true
      },
      {
        "name": "yuanzl77/IPTV",
        "url": "https://raw.githubusercontent.com/yuanzl77/IPTV/master/live.txt",
        "format": "txt",
        "enabled": false
      },
      {
        "name": "fanmingming/live",
        "url": "https://raw.githubusercontent.com/fanmingming/live/main/tv/m3u/ipv6.m3u",
        "format": "m3u",
        "enabled": false,
        "说明": "IPv6 源，带节目单和台标；播放需要本地网络支持 IPv6"
      },
      {
        "name": "vbskycn/iptv IPv6",
        "url": "https://raw.githubusercontent.com/vbskycn/iptv/master/tv/iptv6.txt",
        "format": "txt",
        "enabled": false
      },
      {
        "name": "vbskycn/iptv IPv4",
        "url": "https://raw.githubusercontent.com/vbskycn/iptv/master/tv/iptv4.txt",
        "format": "txt",
        "enabled": true
      },
      {
        "name": "YueChan/Live APTV",
        "url": "https://raw.githubusercontent.com/YueChan/Live/main/APTV.m3u",
        "format": "m3u",
        "enabled": true
      },
      {
        "name": "YanG-1989/m3u Gather",
        "url": "https://raw.githubusercontent.com/YanG-1989/m3u/main/Gather.m3u",
        "format": "m3u",
        "enabled": true
      }
    ],
    "include_keywords": [],
    "exclude_keywords": [
      "测试",
      "Test",
      "geo-blocked",
      "Geo-blocked",
      "Not 24/7",
      "成人",
      "AV",
      "情色",
      " Erotic",
      "Playboy",
      "Hustler",
      "Brazzers",
      "Dorcel",
      "Venus",
      "18+",
      "XXX",
      "Sex",
      "夜欢",
      "寻花"
    ],
    "category_whitelist": [
      "央视",
      "卫视",
      "地方"
    ],
    "category_order": [
      "央视",
      "卫视",
      "地方"
    ],
    "timeout_seconds": 10,
    "retries": 2,
    "retry_delay_seconds": 1,
    "probe": {
      "enabled": true,
      "timeout_seconds": 6,
      "read_limit_bytes": 65536,
      "concurrency": 16,
      "sample_limit": 0,
      "说明": "enabled 为 true 时对频道地址做轻量连通性抽测（小流量 GET，读满 read_limit_bytes 即断开），失败的频道会被剔除；sample_limit 为 0 表示测全部去重后的地址"
    },
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36",
    "output": "dist/iptv.m3u"
  },
  "tvbox": {
    "cms_sources_input": "dist/cms_sources.json",
    "site_timeout_seconds": 15,
    "live_name": "直播源",
    "live_url": "./iptv.m3u",
    "live_epg": "",
    "output": "dist/tvbox.json"
  }
}